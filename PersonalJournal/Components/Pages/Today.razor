@page "/"
@page "/today"

<div class="page-container">
    
    <!-- Page Header -->
    <div class="page-header">
        <div class="h1">Today's Entry</div>
        <p class="sub">One entry per day - make it count!</p>
    </div>

    <!-- Main Card -->
    <section class="card">
        <div class="card-pad">
            
            <!-- Entry Header -->
            <div class="entry-header">
                <div class="date-info">
                    <div class="date-display">Saturday, December 21, 2024</div>
                    <div class="word-count">0 words</div>
                </div>
                <button class="btn">Save Entry</button>
            </div>

            <!-- Title Field -->
            <div class="field">
                <label>Title (Optional)</label>
                <input type="text" placeholder="Give your entry a title..." />
            </div>

            <!-- Rich Text Editor -->
            <div class="field">
                <label>Content</label>
                <div class="editor">
                    <div class="toolbar">
                        <button class="tool">H1</button>
                        <button class="tool">H2</button>
                        <button class="tool"><b>B</b></button>
                        <button class="tool"><i>I</i></button>
                        <button class="tool">• List</button>
                        <button class="tool">1. List</button>
                    </div>
                    <div class="editor-area" contenteditable="true">
                        <span class="placeholder">Write about your day...</span>
                    </div>
                </div>
            </div>

            <!-- Primary Mood -->
            <div class="field">
                <label>Primary Mood *</label>

                <div class="group-title">Positive</div>
                <div class="chips">
                    <button class="chip">Happy</button>
                    <button class="chip">Excited</button>
                    <button class="chip">Relaxed</button>
                    <button class="chip active">Grateful</button>
                    <button class="chip">Confident</button>
                </div>

                <div class="group-title">Neutral</div>
                <div class="chips">
                    <button class="chip blue">Calm</button>
                    <button class="chip blue">Thoughtful</button>
                    <button class="chip blue">Curious</button>
                    <button class="chip blue">Nostalgic</button>
                    <button class="chip blue">Bored</button>
                </div>

                <div class="group-title">Negative</div>
                <div class="chips">
                    <button class="chip red">Sad</button>
                    <button class="chip red">Angry</button>
                    <button class="chip red">Stressed</button>
                    <button class="chip red">Lonely</button>
                    <button class="chip red">Anxious</button>
                </div>
            </div>

            <!-- Secondary Moods -->
            <div class="field">
                <label>Secondary Moods (Optional - Max 2)</label>
                <div class="chips">
                    <button class="chip">Happy</button>
                    <button class="chip">Excited</button>
                    <button class="chip">Relaxed</button>
                    <button class="chip">Grateful</button>
                    <button class="chip">Confident</button>
                    <button class="chip blue">Calm</button>
                    <button class="chip blue">Thoughtful</button>
                    <button class="chip blue">Curious</button>
                    <button class="chip blue">Nostalgic</button>
                    <button class="chip blue">Bored</button>
                    <button class="chip red">Sad</button>
                    <button class="chip red">Angry</button>
                    <button class="chip red">Stressed</button>
                    <button class="chip red">Lonely</button>
                    <button class="chip red">Anxious</button>
                </div>
            </div>

            <!-- Category -->
            <div class="field">
                <label>Category (Optional)</label>
                <input type="text" placeholder="e.g., Personal, Work, Life" />
            </div>

            <!-- Tags -->
            <div class="field">
                <label>Tags (Optional)</label>
                <div class="chips">
                    <button class="chip tag-chip">Work</button>
                    <button class="chip tag-chip">Career</button>
                    <button class="chip tag-chip">Studies</button>
                    <button class="chip tag-chip">Family</button>
                    <button class="chip tag-chip">Friends</button>
                    <button class="chip tag-chip">Relationships</button>
                    <button class="chip tag-chip">Health</button>
                    <button class="chip tag-chip">Fitness</button>
                    <button class="chip tag-chip">Personal Growth</button>
                    <button class="chip tag-chip">Self-care</button>
                    <button class="chip tag-chip">Hobbies</button>
                    <button class="chip tag-chip">Travel</button>
                    <button class="chip tag-chip">Nature</button>
                    <button class="chip tag-chip">Finance</button>
                    <button class="chip tag-chip">Spirituality</button>
                </div>

                <div style="height: 10px"></div>

                <div class="custom-tag-row">
                    <input type="text" placeholder="Enter custom tag" />
                    <button class="btn-ghost">+</button>
                </div>
            </div>

        </div>
    </section>
</div>