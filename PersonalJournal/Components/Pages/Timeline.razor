@page "/timeline"

<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div class="h1">All Entries</div>
        <p class="sub">5 of 5 entries</p>
    </div>

    <!-- Search Bar Card -->
    <div class="card">
        <div class="card-pad">
            <div class="searchbar">
                <div class="searchwrap">
                    <span class="search-icon">🔍</span>
                    <input type="text" placeholder="Search entries by title or content..." />
                </div>
                <button class="btn-ghost">Filters</button>
            </div>
        </div>
    </div>

    <!-- Spacer -->
    <div class="spacer"></div>

    <!-- Entries List Card -->
    <div class="card">
        <div class="card-pad">
            <div class="entries-list">

                <!-- Entry 1 -->
                <div class="entry-card">
                    <div class="entry-title">Building My Journal App</div>
                    <div class="meta">
                        <span class="meta-item">📅 Sat, Dec 21, 2024</span>
                        <span class="pill">
                            <span class="dot dot-pos"></span>
                            Happy
                        </span>
                    </div>
                    <div class="entry-preview">
                        Today I started working on the frontend of my journal application...
                    </div>
                </div>

                <!-- Entry 2 -->
                <div class="entry-card">
                    <div class="entry-title">Sunday Relaxation</div>
                    <div class="meta">
                        <span class="meta-item">📅 Fri, Dec 20, 2024</span>
                        <span class="pill">
                            <span class="dot dot-pos"></span>
                            Relaxed
                        </span>
                    </div>
                    <div class="entry-preview">
                        Spent the day reading and watching movies. Very peaceful...
                    </div>
                </div>

             

            </div>
        </div>
    </div>

</div>